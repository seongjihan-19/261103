# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버(Vercel API, 수집 워커) 전용. 브라우저에 노출하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest

# 공공데이터포털 '소상공인시장진흥공단_상가(상권)정보' 일반 인증키(Decoding 키)
# https://www.data.go.kr/data/15012005/openapi.do
DATA_GO_KR_SERVICE_KEY=your-data-go-kr-key

# 수집 워커 전용 (내 PC에서만 사용)
# aside CLI가 PATH에 없으면 전체 경로를 적어주세요.
ASIDE_CLI=aside
# Aside CLI 로그인 정보 파일 경로 (aside login 할 때와 같은 경로)
ASIDE_CLI_AUTH_PATH=
